{
  "type": "object",
  "properties": {
    "booking_number": {"type": "string", "description": "托书号 / Booking No."},
    "booking_date": {"type": "string", "description": "YYYY-MM-DD"},
    "shipper_name": {"type": "string", "description": "发货人 / Shipper"},
    "shipper_address": {"type": "string"},
    "airline": {"type": "string", "description": "航空公司 / Carrier"},
    "flight_no": {"type": "string", "description": "航班号 / Flight No.，如 CZ3411"},
    "port_of_loading": {"type": "string", "description": "起运机场（IATA 三字码），如 SZX (Shenzhen Bao'an)"},
    "port_of_discharge": {"type": "string", "description": "目的机场（IATA 三字码），如 LAX (Los Angeles)"},
    "place_of_delivery": {"type": "string", "description": "交货地 / Final Destination"},
    "etd": {"type": "string", "description": "预计起飞日 YYYY-MM-DD"},
    "eta": {"type": "string", "description": "预计到港日 YYYY-MM-DD"},
    "cargo_description": {"type": "string", "description": "货名"},
    "packages": {"type": "number", "description": "件数"},
    "gross_weight": {"type": "number", "description": "毛重 kg"},
    "volume": {"type": "number", "description": "体积 m3"},
    "chargeable_weight": {"type": "number", "description": "计费重 kg，max(毛重, 体积×167) 向上进位到 0.5kg"},
    "special_requirements": {"type": "string", "description": "特殊要求，如内置锂电池需随附 UN38.3 报告"},
    "incoterm": {"type": "string"},
    "payment_terms": {"type": "string", "description": "付款条款，如 T/T 30 days"},
    "remarks": {"type": "string"}
  }
}
