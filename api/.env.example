# ====================== DocAssistant · 环境变量模板 ======================
# 复制此文件为 .env 并填入你的 Key，即可从 Mock 模式切换到真实 AI 模式：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，真实 Key 永远不要提交到仓库。
# 缺 Key 时系统自动运行在 Mock 演示模式，Demo 可跑。

# ---------- 智谱 AI · 多模态视觉模型（结构化抽取） ----------
# 控制台：https://open.bigmodel.cn/ （API Keys 页面申请）
# 默认用免费档 glm-4v-flash（无需充值即可跑真实抽取）；
# 充值后可换 glm-4.6v-flashx（更快更强，按量计费）。不设此行即用默认。
ZHIPU_API_KEY=your_zhipu_api_key_here
# ZHIPU_VLM_MODEL=glm-4.6v-flashx
LLM_BASE_URL=https://open.bigmodel.cn
# 单次 VLM 调用超时（秒），多页大单据可适当调大
VLM_TIMEOUT_SECONDS=120

# ---------- Web ----------
# CORS 允许来源，逗号分隔；默认 * 仅建议本地演示使用
# CORS_ALLOW_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# ---------- 腾讯云 · 智能结构化 OCR（可选，预留，无 Key 不阻塞） ----------
TENCENT_SECRET_ID=your_tencent_secret_id_here
TENCENT_SECRET_KEY=your_tencent_secret_key_here
